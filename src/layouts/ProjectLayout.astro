---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  project: {
    id: string;
    data: {
      title: string;
      tagline: string;
      category: string;
      year: string;
      role: string;
      tags: string[];
      accentColor?: string;
      overview: string;
      problem?: string;
      solution?: string;
      architecture?: string[];
      metrics?: Array<{ label: string; value: string }>;
      liveUrl?: string;
      githubUrl?: string;
    };
  };
  nextProject?: {
    id: string;
    data: {
      title: string;
      tagline: string;
      category: string;
    };
  };
}

const { project, nextProject } = Astro.props;
const { title, tagline, category, year, role, tags, accentColor, overview, problem, solution, architecture, metrics, liveUrl, githubUrl } = project.data;
---

<BaseLayout title={`${title} — Case Study`} description={overview}>
  <article class="project-case-study">
    <!-- Case Study Hero Header -->
    <header class="case-study-hero">
      <div class="container">
        <div class="project-hero-top">
          <a href="/#work" class="back-link">← Back to Selected Work</a>
        </div>
        <h1 class="case-study-title">{title}</h1>
        <p class="case-study-tagline">{tagline}</p>

        <!-- Meta Specification Bar -->
        <div class="case-study-meta-grid">
          <div class="meta-column">
            <span class="meta-heading">Role</span>
            <span class="meta-data">{role}</span>
          </div>
          <div class="meta-column">
            <span class="meta-heading">Year</span>
            <span class="meta-data">{year}</span>
          </div>
          <div class="meta-column">
            <span class="meta-heading">Category</span>
            <span class="meta-data">{category}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Case Study Body Content -->
    <section class="case-study-body">
      <div class="container-narrow">
        <!-- Overview & Metrics -->
        <div class="section-block">
          <h2 class="block-title">Project Overview</h2>
          <p class="block-paragraph lead">{overview}</p>

          {metrics && metrics.length > 0 && (
            <div class="metrics-grid">
              {metrics.map((m) => (
                <div class="metric-box">
                  <span class="m-val" style={`color: ${accentColor || '#D99A4C'};`}>{m.value}</span>
                  <span class="m-label">{m.label}</span>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Problem & Solution Split -->
        {(problem || solution) && (
          <div class="section-block challenge-split">
            {problem && (
              <div class="challenge-card">
                <h3 class="card-title">The Challenge</h3>
                <p class="card-text">{problem}</p>
              </div>
            )}
            {solution && (
              <div class="challenge-card solution">
                <h3 class="card-title">The Delivered Solution</h3>
                <p class="card-text">{solution}</p>
              </div>
            )}
          </div>
        )}

        <!-- Highlights Breakdown -->
        {architecture && architecture.length > 0 && (
          <div class="section-block">
            <h2 class="block-title">Key Capabilities & Features</h2>
            <ul class="architecture-list">
              {architecture.map((item, idx) => (
                <li class="arch-item">
                  <span class="arch-idx">0{idx + 1}</span>
                  <span class="arch-text">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Markdown Slot Content -->
        <div class="prose-content">
          <slot />
        </div>

        <!-- Tech Stack Tags -->
        <div class="tech-stack-section">
          <span class="stack-label">Core Technologies</span>
          <div class="stack-pills">
            {tags.map((t) => (
              <span class="stack-pill">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Next Project Pagination -->
    {nextProject && (
      <section class="next-project-section">
        <div class="container">
          <a href={`/work/${nextProject.id}`} class="next-inner">
            <div class="next-label-group">
              <span class="next-eyebrow">Next Project</span>
              <h3 class="next-title">{nextProject.data.title}</h3>
              <p class="next-tagline">{nextProject.data.tagline}</p>
            </div>
            <div class="next-arrow-circle">
              <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project-case-study {
    padding-top: 8rem;
    padding-bottom: 6rem;
  }

  /* Header */
  .case-study-hero {
    margin-bottom: 4rem;
  }

  .breadcrumb-row {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .back-link svg {
    width: 14px;
    height: 14px;
    color: var(--accent);
  }

  .hero-title-group {
    max-width: 900px;
    margin-bottom: 3rem;
  }

  .case-study-title {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0.5rem 0 1rem;
  }

  .case-study-tagline {
    font-size: var(--text-title-3);
    color: var(--text-secondary);
    font-weight: 400;
    line-height: 1.4;
  }

  /* Borderless Meta Grid */
  .case-study-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-lg);
  }

  .meta-column {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-column.actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }

  .meta-heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .meta-data {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }



  /* Body */
  .case-study-body {
    padding: 2rem 0;
  }

  .section-block {
    margin-bottom: 4rem;
  }

  .block-title {
    font-size: var(--text-title-2);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .block-paragraph {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .block-paragraph.lead {
    font-size: var(--text-body-lg);
    color: var(--text-primary);
    line-height: 1.65;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .metric-box {
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .m-val {
    font-size: 2.25rem;
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .m-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Challenge & Solution Split */
  .challenge-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .challenge-card {
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .challenge-card.solution {
    background: rgba(217, 154, 76, 0.04);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .card-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Architecture List */
  .architecture-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .arch-item {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.25rem 1.75rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-md);
  }

  .arch-idx {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--accent);
    font-weight: 600;
  }

  .arch-text {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  /* Prose Content */
  .prose-content {
    margin: 3rem 0;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .prose-content :global(h2) {
    font-size: var(--text-title-2);
    font-weight: 300;
    color: var(--text-primary);
    margin: 2.5rem 0 1rem;
  }

  .prose-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
  }

  .prose-content :global(p) {
    margin-bottom: 1.25rem;
  }

  /* Tech Stack Pills */
  .tech-stack-section {
    padding-top: 2rem;
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stack-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-pill {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  /* Next Project */
  .next-project-section {
    margin-top: 5rem;
  }

  .next-inner {
    padding: 2.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-xl);
    transition: background var(--duration-fast) var(--ease-premium),
                transform var(--duration-fast) var(--ease-premium);
  }

  .next-inner:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .next-label-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .next-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }

  .next-title {
    font-size: var(--text-title-2);
    font-weight: 300;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .next-tagline {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .next-arrow-circle {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    background: var(--accent-muted);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) var(--ease-premium);
  }

  .next-inner:hover .next-arrow-circle {
    background: var(--accent);
    color: #060709;
    transform: rotate(45deg) scale(1.08);
  }

  .next-arrow-circle svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 860px) {
    .case-study-meta-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .meta-column.actions {
      grid-column: span 2;
      justify-content: flex-start;
    }

    .challenge-split {
      grid-template-columns: 1fr;
    }

    .metrics-grid {
      grid-template-columns: 1fr;
    }

    .next-inner {
      padding: 1.75rem;
    }
  }
</style>
