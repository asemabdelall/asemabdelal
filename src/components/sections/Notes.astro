---
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const notes = allNotes.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section class="notes-section section-padding" id="notes" aria-label="Articles & Insights">
  <div class="container">
    <div class="notes-header reveal-fade-up">
      <div class="notes-title-row">
        <h2 class="notes-heading">Insights.</h2>
        <p class="notes-subtext">Thoughts on digital product strategy, scaling web applications, and modern design.</p>
      </div>
    </div>

    <div class="notes-list">
      {notes.map((note, index) => {
        const noteNumber = `0${index + 1}`;
        return (
          <article class="note-row reveal-fade-up">
            <div class="note-left">
              <span class="note-index">{noteNumber}</span>
              <div class="note-title-wrap">
                <h3 class="note-title">{note.data.title}</h3>
                <p class="note-desc">{note.data.description}</p>
              </div>
            </div>

            <div class="note-right">
              <span class="note-readtime">{note.data.readTime}</span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .notes-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .notes-header {
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .notes-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .notes-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .notes-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    max-width: 480px;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .note-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(1.25rem, 2vw, 1.75rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .note-row:last-child {
    border-bottom: none;
  }

  .note-left {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    max-width: 820px;
  }

  .note-index {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    flex-shrink: 0;
  }

  .note-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .note-title {
    font-size: var(--text-title-3);
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .note-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .note-right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .note-readtime {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .note-row {
      flex-direction: column;
      gap: 1rem;
    }

    .note-left {
      gap: 1.25rem;
    }

    .note-right {
      padding-left: 2.5rem;
    }
  }
</style>
