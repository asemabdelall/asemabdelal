---
import { getCollection } from 'astro:content';
import ArrowLink from '../ui/ArrowLink.astro';

const allNotes = await getCollection('notes');
const notes = allNotes.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section class="notes-section section-padding" id="notes" aria-label="Articles & Insights">
  <div class="container">
    <div class="notes-header reveal-fade-up">
      <div class="notes-title-row">
        <h2 class="notes-heading">Insights.</h2>
        <p class="notes-subtext">Thoughts on digital product strategy, scaling web applications, and modern design.</p>
      </div>
    </div>

    <div class="notes-list">
      {notes.map((note, index) => {
        const noteNumber = `0${index + 1}`;
        return (
          <article class="note-row reveal-fade-up">
            <div class="note-left">
              <span class="note-index">{noteNumber}</span>
              <div class="note-title-wrap">
                <h3 class="note-title">{note.data.title}</h3>
                <p class="note-desc">{note.data.description}</p>
              </div>
            </div>

            <div class="note-right">
              <div class="note-meta">
                <span class="note-readtime">{note.data.readTime}</span>
              </div>
              <div class="note-tags">
                {note.data.tags.map((tag) => (
                  <span class="note-tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .notes-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .notes-header {
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .notes-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .notes-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .notes-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    max-width: 480px;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .note-row {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    padding: clamp(1.25rem, 2vw, 1.75rem) 0;
    align-items: center;
  }

  .note-left {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .note-index {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.25rem;
  }

  .note-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .note-title {
    font-size: var(--text-title-3);
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .note-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .note-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
  }

  .note-tags {
    display: flex;
    gap: 0.4rem;
  }

  .note-tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 860px) {
    .note-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .note-right {
      align-items: flex-start;
      padding-left: 3.25rem;
    }
  }
</style>
