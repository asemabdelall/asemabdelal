---
---

<section class="contact-section section-padding" id="contact" aria-label="Contact and Inquiries">
  <div class="container">
    <div class="contact-flow reveal-fade-up">
      <div class="contact-header">
        <h2 class="contact-headline">
          LET'S <span class="accent-text">BUILD</span>.
        </h2>
        <p class="contact-subtext">
          If you are planning a new product, web platform, or mobile application, let's talk through your requirements.
        </p>
      </div>

      <div class="contact-channels">
        <!-- Direct Email Row -->
        <div class="email-action-box">
          <div class="email-details">
            <span class="box-label">Email</span>
            <a href="mailto:asem@asemabdelal.dev" class="email-address" id="contact-email-link">
              asem@asemabdelal.dev
            </a>
          </div>
          
          <button id="copy-email-btn" class="copy-button" aria-label="Copy email address to clipboard">
            <span class="copy-text" id="copy-status-text">Copy Email</span>
            <svg class="copy-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 11V3.5C3 3.22386 3.22386 3 3.5 3H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <!-- Clean Social Links -->
        <div class="social-links-grid">
          <a href="https://github.com/asemabdelal" target="_blank" rel="noopener noreferrer" class="social-item">
            <span class="social-name">GitHub</span>
            <span class="social-handle">@asemabdelal ↗</span>
          </a>

          <a href="https://linkedin.com/in/asemabdelal" target="_blank" rel="noopener noreferrer" class="social-item">
            <span class="social-name">LinkedIn</span>
            <span class="social-handle">in/asemabdelal ↗</span>
          </a>

          <a href="https://t.me/asemabdelal" target="_blank" rel="noopener noreferrer" class="social-item">
            <span class="social-name">Telegram</span>
            <span class="social-handle">@asemabdelal ↗</span>
          </a>

          <a href="https://x.com/asemabdelal" target="_blank" rel="noopener noreferrer" class="social-item">
            <span class="social-name">Twitter / X</span>
            <span class="social-handle">@asemabdelal ↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
    padding-bottom: clamp(6rem, 10vw, 10rem);
  }

  .contact-flow {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }

  .contact-header {
    max-width: 820px;
  }

  .contact-headline {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .accent-text {
    color: var(--accent);
    font-weight: 300;
  }

  .contact-subtext {
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  /* Borderless Email Box */
  .email-action-box {
    background: rgba(255, 255, 255, 0.035);
    border-radius: var(--radius-lg);
    padding: 2rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    transition: background-color var(--duration-fast) var(--ease-premium),
                transform var(--duration-fast) var(--ease-premium);
  }

  .email-action-box:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .email-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .box-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
  }

  .email-address {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .email-address:hover {
    color: var(--accent);
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.65rem 1.25rem;
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-primary);
    transition: all var(--duration-fast) var(--ease-premium);
    flex-shrink: 0;
  }

  .copy-button:hover {
    background: var(--accent);
    color: #060709;
  }

  .copy-button:hover .copy-icon {
    color: #060709;
  }

  .copy-button:active {
    transform: scale(0.96);
  }

  .copy-icon {
    width: 14px;
    height: 14px;
    color: var(--accent);
    transition: color var(--duration-fast) var(--ease-premium);
  }

  /* Borderless Social Links Grid */
  .social-links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .social-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-premium);
  }

  .social-item:hover {
    background: rgba(255, 255, 255, 0.07);
    transform: translateY(-2px);
  }

  .social-name {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .social-handle {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .contact-channels {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .email-action-box {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 540px) {
    .social-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initEmailCopy() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-status-text');
    const email = 'asem@asemabdelal.dev';

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        if (copyText) {
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = 'Copy Email';
          }, 2400);
        }
      } catch (err) {
        console.error('Failed to copy email', err);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initEmailCopy);
  document.addEventListener('astro:page-load', initEmailCopy);
</script>
