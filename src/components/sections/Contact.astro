---
const whatsappNumber = '+96594135865';
const whatsappDisplay = '+965 94135865';
const whatsappUrl = `https://wa.me/96594135865`;

const socialChannels = [
  {
    name: 'GitHub',
    handle: '@asemabdelall ↗',
    url: 'https://github.com/asemabdelall',
    icon: '/icons/github.svg',
    color: '#FFFFFF',
    category: 'Source Code & Systems'
  },
  {
    name: 'Instagram',
    handle: '@asemabdelall ↗',
    url: 'https://www.instagram.com/asemabdelall/',
    icon: '/icons/instagram.svg',
    color: '#E4405F',
    category: 'Updates & Media'
  }
];
---

<section class="contact-section section-padding" id="contact" aria-label="Contact and Inquiries">
  <div class="container">
    <div class="contact-flow">
      <div class="contact-header">
        <h2 class="contact-headline">
          LET'S <span class="accent-text">BUILD</span>.
        </h2>
        <p class="contact-subtext">
          If you are planning a new product, web platform, or mobile application, let's talk through your requirements.
        </p>
      </div>

      <div class="contact-channels">
        <!-- Premium WhatsApp Action Card -->
        <div class="whatsapp-card">
          <div class="whatsapp-header">
            <div class="whatsapp-icon-box">
              <img 
                src="/icons/whatsapp.svg" 
                alt="WhatsApp logo" 
                class="whatsapp-icon-img" 
                width="28" 
                height="28" 
                loading="lazy" 
              />
            </div>
            <div class="whatsapp-meta">
              <span class="card-label">Direct WhatsApp</span>
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="whatsapp-number"
                id="contact-whatsapp-link"
              >
                {whatsappDisplay}
              </a>
            </div>
          </div>

          <div class="whatsapp-actions">
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="action-btn primary"
            >
              <span>Chat on WhatsApp</span>
              <svg class="arrow-svg" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            <button id="copy-phone-btn" class="action-btn secondary" aria-label="Copy phone number">
              <span id="copy-status-text">Copy Number</span>
              <svg class="copy-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M3 11V3.5C3 3.22386 3.22386 3 3.5 3H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>

          <div class="card-ambient-glow" aria-hidden="true"></div>
        </div>

        <!-- Social Channels Grid (GitHub & Instagram) -->
        <div class="social-channels-grid">
          {socialChannels.map((channel) => (
            <a 
              href={channel.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="social-card"
              style={`--social-accent: ${channel.color};`}
            >
              <div class="social-icon-box">
                <img 
                  src={channel.icon} 
                  alt={`${channel.name} icon`} 
                  class="social-icon-img" 
                  width="24" 
                  height="24" 
                  loading="lazy" 
                />
              </div>

              <div class="social-info">
                <div class="social-top-row">
                  <h3 class="social-title">{channel.name}</h3>
                  <span class="social-handle">{channel.handle}</span>
                </div>
                <span class="social-desc">{channel.category}</span>
              </div>

              <div class="social-ambient-glow" aria-hidden="true"></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
    padding-bottom: clamp(6rem, 10vw, 10rem);
  }

  .contact-flow {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }

  .contact-header {
    max-width: 820px;
  }

  .contact-headline {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .accent-text {
    color: var(--accent);
    font-weight: 300;
  }

  .contact-subtext {
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: stretch;
  }

  /* WhatsApp Premium Card */
  .whatsapp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: linear-gradient(135deg, rgba(16, 26, 22, 0.75) 0%, rgba(10, 16, 14, 0.5) 100%);
    border: 1px solid rgba(37, 211, 102, 0.2);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
    transition: transform var(--duration-normal) var(--ease-premium),
                border-color var(--duration-normal) var(--ease-premium),
                box-shadow var(--duration-normal) var(--ease-premium);
  }

  .whatsapp-card:hover {
    transform: translateY(-3px);
    border-color: rgba(37, 211, 102, 0.35);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.65);
  }

  .whatsapp-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .whatsapp-icon-box {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-icon-img {
    width: 1.75rem;
    height: 1.75rem;
    filter: invert(65%) sepia(85%) saturate(450%) hue-rotate(90deg) brightness(98%) contrast(90%);
  }

  .whatsapp-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: #4ADE80;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .whatsapp-number {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .whatsapp-number:hover {
    color: #4ADE80;
  }

  .whatsapp-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-premium);
  }

  .action-btn.primary {
    background: #25D366;
    color: #06080A;
    font-weight: 600;
  }

  .action-btn.primary:hover {
    background: #34E577;
    transform: translateY(-2px);
  }

  .action-btn.secondary {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .action-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.16);
    transform: translateY(-2px);
  }

  .action-btn.secondary:active {
    transform: scale(0.96);
  }

  .arrow-svg, .copy-icon {
    width: 14px;
    height: 14px;
  }

  .card-ambient-glow {
    position: absolute;
    right: -30px;
    bottom: -30px;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, #25D366 0%, transparent 70%);
    opacity: 0.12;
    filter: blur(40px);
    pointer-events: none;
  }

  /* Social Channels Grid */
  .social-channels-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .social-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.6rem;
    background: linear-gradient(135deg, rgba(16, 20, 28, 0.6) 0%, rgba(10, 12, 16, 0.4) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-premium),
                background-color var(--duration-normal) var(--ease-premium),
                border-color var(--duration-normal) var(--ease-premium),
                box-shadow var(--duration-normal) var(--ease-premium);
  }

  .social-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.12);
    background: linear-gradient(135deg, rgba(22, 28, 38, 0.8) 0%, rgba(14, 17, 24, 0.6) 100%);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.5);
  }

  .social-icon-box {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-premium);
  }

  .social-card:hover .social-icon-box {
    transform: scale(1.06);
  }

  .social-icon-img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .social-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .social-top-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .social-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
  }

  .social-handle {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent);
  }

  .social-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .social-ambient-glow {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 90px;
    height: 90px;
    background: radial-gradient(circle, var(--social-accent) 0%, transparent 70%);
    opacity: 0;
    filter: blur(25px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .social-card:hover .social-ambient-glow {
    opacity: 0.18;
  }

  @media (max-width: 900px) {
    .contact-channels {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

<script>
  function initPhoneCopy() {
    const copyBtn = document.getElementById('copy-phone-btn');
    const copyText = document.getElementById('copy-status-text');
    const phone = '+96594135865';

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(phone);
        if (copyText) {
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = 'Copy Number';
          }, 2400);
        }
      } catch (err) {
        console.error('Failed to copy phone number', err);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initPhoneCopy);
  document.addEventListener('astro:page-load', initPhoneCopy);
</script>
