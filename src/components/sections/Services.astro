---
const services = [
  {
    index: "01",
    title: "Product Engineering",
    summary:
      "End-to-end technical delivery from initial prototype to scalable production software.",
  },
  {
    index: "02",
    title: "Full-Stack Web",
    summary:
      "Modern web applications, high-converting landing pages, and responsive UI systems.",
  },
  {
    index: "03",
    title: "Mobile Development",
    summary:
      "Cross-platform mobile apps engineered for offline reliability and native performance.",
  },
  {
    index: "04",
    title: "Realtime Systems",
    summary:
      "Low-latency chat engines, presence tracking, and synchronized live data streams.",
  },
  {
    index: "05",
    title: "Backend & Cloud",
    summary:
      "High-throughput APIs, relational database modeling, background queues, and cloud setup.",
  },
  {
    index: "06",
    title: "Artificial Intelligence",
    summary:
      "Conversational AI assistants, intelligent document parsing, and automated workflows.",
  },
];
---

<section
  class="services-section section-padding"
  id="services"
  aria-label="Services & Technical Capabilities"
>
  <div class="container">
    <div class="services-header">
      <h2 class="services-heading">Services.</h2>
      <p class="services-subtext">
        Technical execution across web platforms, mobile applications, realtime
        infrastructure, and AI systems.
      </p>
    </div>

    <!-- Clean Typographic Bento Grid matching TechStack background & hover with Unified Accent -->
    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <div class="service-top">
              <span class="service-index">{service.index}</span>
            </div>

            <div class="service-content">
              <h3 class="service-title">{service.title}</h3>
              <p class="service-summary">{service.summary}</p>
            </div>

            <div class="service-ambient-glow" aria-hidden="true" />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .services-header {
    max-width: 800px;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .services-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .services-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* 3-Column Symmetrical Grid on Desktop, 2-Column on Tablet, 1-Column on Mobile */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Exact TechStack Card Background, Structure & Physics */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem 1.85rem;
    background: linear-gradient(
      135deg,
      rgba(16, 20, 28, 0.6) 0%,
      rgba(10, 12, 16, 0.4) 100%
    );
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--duration-normal) var(--ease-premium),
      background-color var(--duration-normal) var(--ease-premium),
      box-shadow var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover {
    transform: translateY(-4px);
    background: linear-gradient(
      135deg,
      rgba(22, 28, 38, 0.8) 0%,
      rgba(14, 17, 24, 0.6) 100%
    );
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .service-top {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .service-index {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(217, 154, 76, 0.1);
    border: 1px solid rgba(217, 154, 76, 0.2);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .service-card:hover .service-title {
    color: var(--accent);
  }

  .service-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Exact TechStack Ambient Radial Glow (Unified Gold Accent) */
  .service-ambient-glow {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 90px;
    height: 90px;
    background: radial-gradient(
      circle,
      var(--accent) 0%,
      transparent 70%
    );
    opacity: 0;
    filter: blur(25px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover .service-ambient-glow {
    opacity: 0.22;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service-card {
      padding: 1.4rem 1.4rem;
    }
  }
</style>
