---
const services = [
  {
    index: '01',
    title: 'Product Engineering',
    category: 'Architecture & Delivery',
    summary: 'End-to-end technical delivery from initial prototype to scalable production software.'
  },
  {
    index: '02',
    title: 'Full-Stack Systems',
    category: 'Web Apps & Platforms',
    summary: 'Modern web applications, high-converting landing pages, and backend infrastructure.'
  },
  {
    index: '03',
    title: 'Realtime Architecture',
    category: 'Live Messaging & Events',
    summary: 'Low-latency chat engines, live presence, and synchronized real-time state streams.'
  },
  {
    index: '04',
    title: 'Mobile Applications',
    category: 'iOS & Android Apps',
    summary: 'Cross-platform mobile applications engineered for offline reliability and native feel.'
  },
  {
    index: '05',
    title: 'Artificial Intelligence',
    category: 'LLMs & Automation',
    summary: 'Custom conversational AI assistants, intelligent document analysis, and automated workflows.'
  }
];
---

<section class="services-section section-padding" id="services" aria-label="Services & Technical Capabilities">
  <div class="container">
    <div class="services-header">
      <h2 class="services-heading">Services.</h2>
      <p class="services-subtext">Technical execution across web platforms, mobile applications, realtime infrastructure, and AI systems.</p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-index">{service.index}</span>
            <span class="service-arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>

          <div class="service-card-main">
            <h3 class="service-title">{service.title}</h3>
            <span class="service-category">{service.category}</span>
            <p class="service-summary">{service.summary}</p>
          </div>

          <div class="service-ambient-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .services-header {
    max-width: 800px;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .services-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .services-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Professional Responsive Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    padding: 1.75rem 1.85rem;
    background: linear-gradient(135deg, rgba(16, 20, 28, 0.6) 0%, rgba(10, 12, 16, 0.4) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-premium),
                background-color var(--duration-normal) var(--ease-premium),
                border-color var(--duration-normal) var(--ease-premium),
                box-shadow var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(217, 154, 76, 0.3);
    background: linear-gradient(135deg, rgba(22, 28, 38, 0.85) 0%, rgba(14, 17, 24, 0.65) 100%);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .service-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .service-index {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(217, 154, 76, 0.1);
    border: 1px solid rgba(217, 154, 76, 0.2);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .service-arrow {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-premium);
  }

  .service-arrow svg {
    width: 13px;
    height: 13px;
  }

  .service-card:hover .service-arrow {
    background: var(--accent);
    color: #06080A;
    transform: translate(2px, -2px);
  }

  .service-card-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-title {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .service-card:hover .service-title {
    color: var(--accent);
  }

  .service-category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent);
    opacity: 0.85;
    letter-spacing: 0.02em;
  }

  .service-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.35rem;
  }

  .service-ambient-glow {
    position: absolute;
    right: -25px;
    bottom: -25px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    opacity: 0;
    filter: blur(35px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover .service-ambient-glow {
    opacity: 0.16;
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service-card {
      padding: 1.4rem 1.4rem;
    }
  }
</style>
