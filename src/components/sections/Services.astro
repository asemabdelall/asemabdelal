---
interface ServiceItem {
  index: string;
  title: string;
  category: string;
  summary: string;
  color: string;
  iconSvg: string;
}

const services: ServiceItem[] = [
  {
    index: '01',
    title: 'Product Engineering',
    category: 'Architecture & Delivery',
    summary: 'End-to-end technical delivery from initial prototype to scalable production software.',
    color: '#D99A4C',
    iconSvg: `<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>`
  },
  {
    index: '02',
    title: 'Full-Stack Web',
    category: 'Web Apps & Landing Pages',
    summary: 'Modern web applications, high-converting landing pages, and responsive UI systems.',
    color: '#38BDF8',
    iconSvg: `<rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>`
  },
  {
    index: '03',
    title: 'Mobile Development',
    category: 'iOS & Android Apps',
    summary: 'Cross-platform mobile apps engineered for offline reliability and native performance.',
    color: '#A855F7',
    iconSvg: `<rect x="5" y="2" width="14" height="20" rx="3" stroke="currentColor" stroke-width="1.75"/><path d="M11 18h2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>`
  },
  {
    index: '04',
    title: 'Realtime Systems',
    category: 'Live Data & Messaging',
    summary: 'Low-latency chat engines, presence tracking, and synchronized live data streams.',
    color: '#10B981',
    iconSvg: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>`
  },
  {
    index: '05',
    title: 'Backend & Cloud',
    category: 'APIs & Infrastructure',
    summary: 'High-throughput APIs, relational database modeling, background queues, and cloud setup.',
    color: '#E0234E',
    iconSvg: `<rect x="2" y="2" width="20" height="8" rx="2" stroke="currentColor" stroke-width="1.75"/><rect x="2" y="14" width="20" height="8" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M6 6h.01M6 18h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`
  },
  {
    index: '06',
    title: 'Artificial Intelligence',
    category: 'LLM Integrations & AI',
    summary: 'Conversational AI assistants, intelligent document parsing, and automated workflows.',
    color: '#EC4899',
    iconSvg: `<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.75"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>`
  }
];
---

<section class="services-section section-padding" id="services" aria-label="Services & Technical Capabilities">
  <div class="container">
    <div class="services-header">
      <h2 class="services-heading">Services.</h2>
      <p class="services-subtext">Technical execution across web platforms, mobile applications, realtime infrastructure, and AI systems.</p>
    </div>

    <!-- Symmetrical Responsive Grid matching TechStack aesthetics -->
    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card" style={`--service-accent: ${service.color};`}>
          <div class="service-top-row">
            <div class="service-icon-box">
              <svg class="service-icon-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" set:html={service.iconSvg} />
            </div>
            <span class="service-index">{service.index}</span>
          </div>

          <div class="service-info">
            <h3 class="service-title">{service.title}</h3>
            <span class="service-category">{service.category}</span>
            <p class="service-summary">{service.summary}</p>
          </div>

          <div class="service-ambient-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .services-header {
    max-width: 800px;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .services-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .services-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Symmetrical 3-Column Grid on Desktop, 2-Column on Tablet, 1-Column on Mobile */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Exact TechStack card styling & physics */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 220px;
    padding: 1.75rem 1.85rem;
    background: linear-gradient(135deg, rgba(16, 20, 28, 0.6) 0%, rgba(10, 12, 16, 0.4) 100%);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-premium),
                background-color var(--duration-normal) var(--ease-premium),
                box-shadow var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover {
    transform: translateY(-4px);
    background: linear-gradient(135deg, rgba(22, 28, 38, 0.8) 0%, rgba(14, 17, 24, 0.6) 100%);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .service-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .service-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03);
    color: var(--service-accent);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover .service-icon-box {
    transform: scale(1.08);
  }

  .service-icon-svg {
    width: 1.65rem;
    height: 1.65rem;
  }

  .service-index {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .service-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .service-category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.4;
  }

  .service-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.4rem;
  }

  /* Exact TechStack Ambient Radial Glow */
  .service-ambient-glow {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 90px;
    height: 90px;
    background: radial-gradient(circle, var(--service-accent) 0%, transparent 70%);
    opacity: 0;
    filter: blur(25px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover .service-ambient-glow {
    opacity: 0.22;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .service-card {
      padding: 1.4rem 1.4rem;
      min-height: auto;
    }
  }
</style>
