---
const services = [
  {
    index: '01',
    title: 'Product Engineering',
    category: 'Architecture & Production Delivery',
    summary: 'End-to-end technical execution — transforming product roadmaps into scalable, production-ready web and cloud software.',
    skills: ['System Architecture', 'Rapid Prototyping', 'Cloud Infrastructure']
  },
  {
    index: '02',
    title: 'Full-Stack Systems',
    category: 'Web Applications & Landing Pages',
    summary: 'Modern web platforms, high-converting landing pages, relational database modeling, and automated business workflows.',
    skills: ['SaaS Platforms', 'Landing Pages', 'Database Design', 'Stripe Billing']
  },
  {
    index: '03',
    title: 'Realtime Architecture',
    category: 'Live Messaging & Event Streams',
    summary: 'Low-latency messaging engines, live presence, media streaming, and resilient state synchronization across clients.',
    skills: ['WebSockets', 'Live Chat Systems', 'Event-Driven Queues', 'State Sync']
  },
  {
    index: '04',
    title: 'Mobile Applications',
    category: 'iOS & Android Ecosystems',
    summary: 'Cross-platform mobile applications engineered for offline reliability, tactile gesture UI, and native device performance.',
    skills: ['React Native / Expo', 'Offline Caching', 'Push Notifications', 'Native APIs']
  },
  {
    index: '05',
    title: 'Artificial Intelligence',
    category: 'LLM Integrations & Automation',
    summary: 'Integrating conversational AI consultants, smart document processing, and automated pipelines directly into user products.',
    skills: ['Conversational Agents', 'LLM Workflows', 'Document Parsing', 'Workflow Automation']
  }
];
---

<section class="services-section section-padding" id="services" aria-label="Services & Technical Capabilities">
  <div class="container">
    <div class="services-header">
      <h2 class="services-heading">Services.</h2>
      <p class="services-subtext">Technical execution across web platforms, mobile applications, realtime infrastructure, and AI systems.</p>
    </div>

    <div class="services-list">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-header-row">
            <div class="service-title-group">
              <span class="service-index">{service.index}</span>
              <div>
                <h3 class="service-title">{service.title}</h3>
                <span class="service-category">{service.category}</span>
              </div>
            </div>

            <span class="service-arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>

          <p class="service-summary">{service.summary}</p>

          <div class="service-tags">
            {service.skills.map((skill) => (
              <span class="service-pill">{skill}</span>
            ))}
          </div>

          <div class="service-ambient-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .services-header {
    max-width: 800px;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .services-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .services-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Services Grid */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 2.5vw, 2rem) clamp(1.5rem, 2.5vw, 2.25rem);
    background: linear-gradient(135deg, rgba(16, 20, 28, 0.6) 0%, rgba(10, 12, 16, 0.4) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-premium),
                background-color var(--duration-normal) var(--ease-premium),
                border-color var(--duration-normal) var(--ease-premium),
                box-shadow var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: rgba(217, 154, 76, 0.3);
    background: linear-gradient(135deg, rgba(22, 28, 38, 0.8) 0%, rgba(14, 17, 24, 0.6) 100%);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .service-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .service-title-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .service-index {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(217, 154, 76, 0.1);
    border: 1px solid rgba(217, 154, 76, 0.2);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .service-card:hover .service-title {
    color: var(--accent);
  }

  .service-category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: block;
    margin-top: 0.15rem;
  }

  .service-arrow {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-premium);
    flex-shrink: 0;
  }

  .service-arrow svg {
    width: 13px;
    height: 13px;
  }

  .service-card:hover .service-arrow {
    background: var(--accent);
    color: #06080A;
    transform: translate(2px, -2px);
  }

  .service-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 780px;
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  .service-pill {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) var(--ease-premium);
  }

  .service-card:hover .service-pill {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .service-ambient-glow {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    opacity: 0;
    filter: blur(35px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .service-card:hover .service-ambient-glow {
    opacity: 0.14;
  }

  @media (max-width: 640px) {
    .service-card {
      padding: 1.25rem 1.25rem;
      gap: 1rem;
    }

    .service-title-group {
      gap: 0.85rem;
    }

    .service-title {
      font-size: 1.1rem;
    }
  }
</style>
