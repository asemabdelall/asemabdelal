---
const experienceList = [
  {
    period: '2026',
    focus: 'Product Engineering',
    subtitle: 'AI & Scalable Web Platforms',
    description: 'Architecting end-to-end digital products, integrating intelligent AI workflows, and building high-performance, conversion-oriented web platforms.',
    deliverables: ['AI Integrations', 'Product Architecture', 'High-Speed Web', 'System Reliability']
  },
  {
    period: '2025',
    focus: 'Business Systems',
    subtitle: 'Enterprise Platforms & Operations',
    description: 'Engineering multi-tenant business software, custom ERP platforms, automated workflows, and high-security transactional infrastructure.',
    deliverables: ['Custom ERP Systems', 'Cloud Infrastructure', 'Authentication & RBAC', 'Data Pipelines']
  },
  {
    period: '2024',
    focus: 'Web & Mobile',
    subtitle: 'Interactive Applications & UX',
    description: 'Developing fluid cross-platform mobile apps, real-time communication tools, and conversion-focused responsive user interfaces.',
    deliverables: ['Mobile Apps', 'Realtime Systems', 'UI/UX Design Systems', 'REST & GraphQL APIs']
  }
];
---

<section class="experience-section section-padding" id="experience" aria-label="Professional Experience">
  <div class="container">
    <div class="experience-header">
      <h2 class="experience-heading">Experience.</h2>
    </div>

    <div class="experience-timeline">
      {experienceList.map((exp) => (
        <div class="timeline-row">
          <div class="timeline-period">
            <span class="period-text">{exp.period}</span>
          </div>

          <div class="timeline-main">
            <div class="role-org-group">
              <h3 class="role-title">{exp.focus}</h3>
              <span class="org-name">— {exp.subtitle}</span>
            </div>
            <p class="role-description">{exp.description}</p>
          </div>

          <div class="timeline-deliverables">
            {exp.deliverables.map((item) => (
              <span class="deliverable-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .experience-header {
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .experience-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 3.5vw, 3.5rem);
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 160px 1.4fr 1fr;
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    padding: clamp(1.5rem, 2.5vw, 2.25rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    align-items: start;
  }

  .timeline-row:last-child {
    border-bottom: none;
  }

  .timeline-period {
    display: flex;
    align-items: center;
  }

  .period-text {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .timeline-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .role-org-group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .role-title {
    font-size: var(--text-title-3);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .org-name {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: 400;
  }

  .role-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 540px;
  }

  .timeline-deliverables {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .deliverable-tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 960px) {
    .timeline-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .timeline-deliverables {
      justify-content: flex-start;
    }
  }
</style>
