---
const services = [
  {
    index: '01',
    title: 'Web & SaaS Applications',
    summary: 'Web platforms and software-as-a-service applications built with modern frameworks, clean state management, and Stripe integration.',
    tags: ['Full-Stack Web Apps', 'SaaS Architecture', 'Realtime Features', 'Payments & Billing']
  },
  {
    index: '02',
    title: 'Mobile App Development',
    summary: 'Cross-platform mobile applications for iOS and Android with offline caching, push notifications, and device integrations.',
    tags: ['iOS & Android Apps', 'Offline Storage', 'App Store Publishing', 'Push Notifications']
  },
  {
    index: '03',
    title: 'Backend & Database Systems',
    summary: 'REST and GraphQL APIs, relational database modeling, background queues, and secure authentication systems.',
    tags: ['Custom APIs', 'Database Design', 'Cloud Setup', 'Authentication & RBAC']
  },
  {
    index: '04',
    title: 'UI/UX & Design Systems',
    summary: 'Structured design systems, reusable component libraries, and responsive layouts tailored to your product identity.',
    tags: ['Interactive Prototypes', 'Design Systems', 'Responsive Layouts', 'Design Tokens']
  },
  {
    index: '05',
    title: 'AI & Workflow Automation',
    summary: 'Custom LLM integrations, document parsing, automated business pipelines, and internal team tooling.',
    tags: ['AI Integrations', 'LLM Assistants', 'Document Parsing', 'Custom Pipelines']
  }
];
---

<section class="capabilities-section section-padding" id="services" aria-label="Services & Capabilities">
  <div class="container">
    <div class="capabilities-header">
      <h2 class="capabilities-heading">Services.</h2>
    </div>

    <div class="capabilities-table">
      {services.map((service) => (
        <div class="capability-row">
          <div class="row-left">
            <span class="cap-index">{service.index}</span>
            <h3 class="cap-title">{service.title}</h3>
          </div>

          <div class="row-middle">
            <p class="cap-summary">{service.summary}</p>
          </div>

          <div class="row-right">
            <div class="cap-skills">
              {service.tags.map((tag) => (
                <span class="cap-pill">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .capabilities-header {
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .capabilities-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  /* Borderless Services Table */
  .capabilities-table {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .capability-row {
    display: grid;
    grid-template-columns: 240px 1.5fr 1fr;
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    padding: clamp(1.25rem, 2vw, 1.75rem) 0;
    align-items: baseline;
    transition: background-color var(--duration-fast) var(--ease-premium);
  }

  .row-left {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .cap-index {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .cap-title {
    font-size: var(--text-title-3);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .row-middle {
    max-width: 540px;
  }

  .cap-summary {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .row-right {
    display: flex;
    justify-content: flex-end;
  }

  .cap-skills {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .cap-pill {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 960px) {
    .capability-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .row-right {
      justify-content: flex-start;
    }

    .cap-skills {
      justify-content: flex-start;
    }
  }
</style>
