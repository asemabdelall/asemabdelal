---
const capabilities = [
  {
    index: '01',
    title: 'Product Engineering',
    summary: 'System architecture, rapid prototyping, and end-to-end production delivery.'
  },
  {
    index: '02',
    title: 'Full-Stack Systems',
    summary: 'Web applications, high-performance landing pages, and backend infrastructure.'
  },
  {
    index: '03',
    title: 'Realtime Architecture',
    summary: 'Live messaging, WebSockets, media streaming, and real-time state synchronization.'
  },
  {
    index: '04',
    title: 'Mobile Applications',
    summary: 'Cross-platform iOS and Android apps with offline caching and native performance.'
  },
  {
    index: '05',
    title: 'Artificial Intelligence',
    summary: 'Custom LLM integrations, conversational AI agents, and automated data pipelines.'
  }
];
---

<section class="capabilities-section section-padding" id="capabilities" aria-label="Core Capabilities">
  <div class="container">
    <div class="capabilities-header">
      <h2 class="capabilities-heading">Capabilities.</h2>
    </div>

    <div class="capabilities-list">
      {capabilities.map((item) => (
        <div class="capability-row">
          <div class="row-left">
            <span class="cap-index">{item.index}</span>
            <h3 class="cap-title">{item.title}</h3>
          </div>

          <div class="row-right">
            <p class="cap-summary">{item.summary}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .capabilities-header {
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
  }

  .capabilities-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  /* Concise Minimalist Capabilities List */
  .capabilities-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .capability-row {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    padding: clamp(1.5rem, 2.5vw, 2.25rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    align-items: baseline;
    transition: background-color var(--duration-fast) var(--ease-premium);
  }

  .capability-row:last-child {
    border-bottom: none;
  }

  .row-left {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .cap-index {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .cap-title {
    font-size: var(--text-title-3);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .row-right {
    max-width: 600px;
  }

  .cap-summary {
    font-size: var(--text-body);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .capability-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem 0;
    }
  }
</style>
