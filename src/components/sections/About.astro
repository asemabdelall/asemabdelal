---
const pillars = [
  {
    index: '01',
    title: 'Speed & Reliability',
    desc: 'Fast page loads and stable architecture across devices.',
    color: '#38BDF8'
  },
  {
    index: '02',
    title: 'End-to-End Execution',
    desc: 'From system design and APIs to frontend delivery and cloud setup.',
    color: '#D99A4C'
  },
  {
    index: '03',
    title: 'Design & UX Detail',
    desc: 'Clean typography, cohesive design systems, and intuitive flows.',
    color: '#A855F7'
  }
];
---

<section class="about-section section-padding" id="about" aria-label="About Philosophy">
  <div class="container">
    <div class="about-header">
      <h2 class="about-statement">
        I design and build digital products for <span class="text-highlight">web and mobile</span>.
      </h2>
    </div>

    <div class="about-grid">
      <div class="about-narrative">
        <p class="narrative-lead">
          I build digital products from prototype to production — delivering fast, scalable software with clean code and intuitive user flows.
        </p>
      </div>

      <div class="about-pillars">
        {pillars.map((pillar) => (
          <div class="pillar-item" style={`--pillar-color: ${pillar.color};`}>
            <span class="pillar-index">{pillar.index}</span>
            <div class="pillar-content">
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-desc">{pillar.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: linear-gradient(to bottom, rgba(6, 7, 9, 0.4) 0%, rgba(6, 7, 9, 0.95) 12%, var(--bg) 25%, var(--bg) 100%);
    position: relative;
    z-index: 2;
  }

  .about-header {
    max-width: 980px;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .about-statement {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .text-highlight {
    color: var(--text-primary);
    position: relative;
    display: inline-block;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .about-narrative {
    display: flex;
    flex-direction: column;
  }

  .narrative-lead {
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    font-weight: 350;
    color: var(--text-secondary);
    line-height: 1.65;
    letter-spacing: -0.01em;
  }

  .about-pillars {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .pillar-index {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--pillar-color);
    padding-top: 0.1rem;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .pillar-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pillar-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
