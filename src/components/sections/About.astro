---
const pillars = [
  {
    index: '01',
    title: 'Speed & Reliability',
    desc: 'Fast page loads and stable architecture across devices.',
    color: '#38BDF8'
  },
  {
    index: '02',
    title: 'End-to-End Execution',
    desc: 'From system design and APIs to frontend delivery and cloud setup.',
    color: '#D99A4C'
  },
  {
    index: '03',
    title: 'Design & UX Detail',
    desc: 'Clean typography, cohesive design systems, and intuitive flows.',
    color: '#A855F7'
  }
];
---

<section class="about-section section-padding" id="about" aria-label="About Philosophy">
  <div class="container">
    <div class="about-header">
      <h2 class="about-statement">
        I design and build digital products for <span class="text-highlight">web and mobile</span>.
      </h2>
    </div>

    <!-- 3 Horizontal Pillars across width -->
    <div class="about-pillars">
      {pillars.map((pillar) => (
        <div class="pillar-item" style={`--pillar-color: ${pillar.color};`}>
          <span class="pillar-index">{pillar.index}</span>
          <div class="pillar-content">
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-desc">{pillar.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section {
    background: linear-gradient(to bottom, rgba(6, 7, 9, 0.4) 0%, rgba(6, 7, 9, 0.95) 12%, var(--bg) 25%, var(--bg) 100%);
    position: relative;
    z-index: 2;
  }

  .about-header {
    max-width: 980px;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .about-statement {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .text-highlight {
    color: var(--text-primary);
    position: relative;
    display: inline-block;
  }

  /* 3-Column Horizontal Grid */
  .about-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .pillar-item {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .pillar-index {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--pillar-color);
  }

  .pillar-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pillar-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .about-pillars {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
