---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import ArrowLink from '../ui/ArrowLink.astro';
import mixchatImg from '../../assets/images/mixchat.png';
import rahafitImg from '../../assets/images/rahafit.png';
import goldproImg from '../../assets/images/goldpro.png';
import goldproWebImg from '../../assets/images/goldpro-web.png';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const projectImages: Record<string, ImageMetadata> = {
  'mixchat': mixchatImg,
  'rahafit': rahafitImg,
  'goldpro': goldproImg,
  'goldpro-web': goldproWebImg,
};
---

<section class="work-section section-padding" id="work" aria-label="Selected Work">
  <div class="container">
    <!-- Section Introduction -->
    <div class="work-header">
      <div class="work-title-row">
        <h2 class="work-heading">Selected Work.</h2>
        <p class="work-subtext">Recent digital products, mobile applications, and custom business platforms.</p>
      </div>
    </div>

    <!-- Projects Story Flow -->
    <div class="projects-list">
      {projects.map((project, index) => {
        const isReversed = index % 2 !== 0;
        const projectNumber = `0${index + 1}`;
        const imageAsset = projectImages[project.id];

        return (
          <article class={`project-story-item ${isReversed ? 'is-reversed' : ''}`}>
            <!-- Project Interactive Media Showcase -->
            <a href={`/work/${project.id}`} class="project-media-card" aria-label={`View ${project.data.title} case study`}>
              <div class="project-media-inner">
                <div class="media-real-image-container">
                  {imageAsset ? (
                    <Image 
                      src={imageAsset} 
                      alt={`${project.data.title} showcase screenshot`} 
                      class="project-showcase-img"
                      loading="lazy"
                    />
                  ) : (
                    <img 
                      src={project.data.image} 
                      alt={project.data.title} 
                      class="project-showcase-img"
                      loading="lazy"
                    />
                  )}
                </div>

                <!-- Ambient Glow -->
                <div class="card-ambient-glow" style={`--glow-color: ${project.data.accentColor || '#D99A4C'};`}></div>
              </div>
            </a>

            <!-- Project Narrative & Metadata -->
            <div class="project-details">
              <div class="project-meta-top">
                <span class="project-index">{projectNumber}</span>
                <span class="project-category">{project.data.category}</span>
                <span class="project-year">{project.data.year}</span>
              </div>

              <h3 class="project-title">
                <a href={`/work/${project.id}`}>{project.data.title}</a>
              </h3>

              <p class="project-tagline">{project.data.tagline}</p>

              <p class="project-overview-snippet">{project.data.overview}</p>

              <div class="project-tags">
                {project.data.tags.map((tag) => (
                  <span class="tech-tag">{tag}</span>
                ))}
              </div>

              <div class="project-action-row">
                <ArrowLink 
                  href={`/work/${project.id}`} 
                  text="View Case Study" 
                  variant="pill" 
                />
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .work-section {
    background-color: var(--bg);
    position: relative;
    z-index: 2;
  }

  .work-header {
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  .work-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .work-heading {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .work-subtext {
    font-size: var(--text-body);
    color: var(--text-secondary);
    max-width: 460px;
  }

  /* Project Story Flow */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: clamp(6rem, 10vw, 11rem);
  }

  .project-story-item {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }

  .project-story-item.is-reversed {
    grid-template-columns: 1fr 1.35fr;
  }

  .project-story-item.is-reversed .project-media-card {
    order: 2;
  }

  .project-story-item.is-reversed .project-details {
    order: 1;
  }

  /* Borderless Media Card */
  .project-media-card {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .project-media-inner {
    aspect-ratio: 16 / 10;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 2.5vw, 2.25rem);
    background: linear-gradient(135deg, #0D0F14 0%, #07090C 100%);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6);
    transition: transform var(--duration-normal) var(--ease-premium),
                box-shadow var(--duration-normal) var(--ease-premium);
  }

  .project-media-card:hover .project-media-inner {
    transform: translateY(-3px);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.75);
  }

  .card-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 65%;
    height: 65%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--glow-color) 0%, transparent 70%);
    opacity: 0.08;
    filter: blur(40px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .project-media-card:hover .card-ambient-glow {
    opacity: 0.18;
  }






  /* Real Image Showcase */
  .media-real-image-container {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #090B0E;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
  }

  .project-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--duration-normal) var(--ease-premium);
  }

  .project-media-card:hover .project-showcase-img {
    transform: scale(1.03);
  }

  /* Project Details Styling */
  .project-details {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .project-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
  }

  .project-index {
    color: var(--accent);
    font-weight: 600;
  }

  .project-title {
    font-size: var(--text-title-2);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .project-title a:hover {
    color: var(--accent);
  }

  .project-tagline {
    font-size: var(--text-body);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .project-overview-snippet {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Clean Sans Tags */
  .tech-tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .project-action-row {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 0.5rem;
  }



  /* Responsive */
  @media (max-width: 980px) {
    .project-story-item,
    .project-story-item.is-reversed {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .project-story-item.is-reversed .project-media-card {
      order: 1;
    }

    .project-story-item.is-reversed .project-details {
      order: 2;
    }

    .mixchat-grid {
      grid-template-columns: 1fr;
    }

    .mixchat-sidebar {
      display: none;
    }
  }
</style>
