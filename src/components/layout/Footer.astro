---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-left">
        <a href="/" class="footer-brand" aria-label="Back to home">
          <span>ASEM ABDELAL</span>
        </a>
        <span class="footer-tagline">Scalable products. Thoughtful systems.</span>
      </div>

      <div class="footer-right">
        <span class="copyright">© {currentYear} Asem Abdelal</span>
        <button id="back-to-top" class="back-to-top-btn" aria-label="Back to top">
          <span>Back to Top</span>
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 12.5V3.5M8 3.5L3.5 8M8 3.5L12.5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    background-color: var(--bg);
    padding: 4.5rem 0 4rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-brand {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    user-select: none;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .footer-brand:hover {
    color: var(--accent);
  }

  .footer-tagline {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .copyright {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem 0;
    transition: color var(--duration-fast) var(--ease-premium),
                transform var(--duration-fast) var(--ease-premium);
  }

  .back-to-top-btn:hover {
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .back-to-top-btn svg {
    width: 13px;
    height: 13px;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .footer-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  function initBackToTop() {
    const topBtn = document.getElementById('back-to-top');
    topBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  document.addEventListener('DOMContentLoaded', initBackToTop);
  document.addEventListener('astro:page-load', initBackToTop);
</script>
