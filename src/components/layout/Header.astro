---
const navLinks = [
  { label: 'About', href: '/#about' },
  { label: 'Work', href: '/#work' },
  { label: 'Services', href: '/#capabilities' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Insights', href: '/#notes' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header" id="main-header">
  <div class="header-container">
    <!-- Brand Monogram -->
    <a href="/" class="brand-monogram" aria-label="Asem Abdelal — Home">
      <span class="monogram-letter">ASEM ABDELAL</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class="nav-item">
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Menu Button Trigger -->
    <div class="mobile-actions">
      <button 
        id="mobile-menu-toggle" 
        class="mobile-menu-trigger" 
        aria-label="Open menu" 
        aria-expanded="false"
        aria-controls="mobile-nav-overlay"
      >
        <span class="hamburger-line top"></span>
        <span class="hamburger-line middle"></span>
        <span class="hamburger-line bottom"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Fullscreen Glass Overlay Menu -->
  <div id="mobile-nav-overlay" class="mobile-nav-overlay" aria-hidden="true">
    <div class="mobile-nav-content">
      <nav class="mobile-nav-links" aria-label="Mobile Navigation">
        {navLinks.map((link, index) => (
          <a href={link.href} class="mobile-nav-link" style={`--stagger-index: ${index};`}>
            <span class="link-number">0{index + 1}</span>
            <span class="link-text">{link.label}</span>
          </a>
        ))}
      </nav>

      <div class="mobile-nav-footer">
        <div class="mobile-contact-meta">
          <span class="meta-label">DIRECT WHATSAPP</span>
          <a href="https://wa.me/96594135865" target="_blank" rel="noopener noreferrer" class="meta-email">+965 94135865 ↗</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    padding: 3.25rem var(--page-padding-x);
    transition: background-color var(--duration-normal) var(--ease-premium),
                backdrop-filter var(--duration-normal) var(--ease-premium),
                padding var(--duration-normal) var(--ease-premium);
  }

  .site-header.is-scrolled {
    padding: 1.70rem var(--page-padding-x);
    background-color: var(--bg-surface-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Monogram Logo */
  .brand-monogram {
    font-family: var(--font-sans);
    font-size: 1.625rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    transition: opacity var(--duration-fast) var(--ease-premium);
  }

  .brand-monogram:hover {
    opacity: 0.85;
  }

  .brand-monogram .accent-dot {
    color: var(--accent);
    margin-left: 1px;
    font-size: 1.75rem;
    line-height: 0;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.75rem;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-premium);
    position: relative;
    padding: 0.35rem 0;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  /* Mobile Circular Trigger */
  .mobile-actions {
    display: none;
  }

  .mobile-menu-trigger {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0;
    transition: all var(--duration-fast) var(--ease-premium);
    z-index: calc(var(--z-header) + 10);
  }

  .mobile-menu-trigger:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .hamburger-line {
    width: 18px;
    height: 1.5px;
    background-color: var(--text-primary);
    border-radius: 1px;
    transition: transform var(--duration-normal) var(--ease-premium),
                opacity var(--duration-normal) var(--ease-premium);
  }

  /* Morphing hamburger to X */
  .mobile-menu-trigger.is-open .hamburger-line.top {
    transform: translateY(5.5px) rotate(45deg);
  }

  .mobile-menu-trigger.is-open .hamburger-line.middle {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu-trigger.is-open .hamburger-line.bottom {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* Mobile Fullscreen Overlay */
  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    background-color: rgba(6, 7, 9, 0.98);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    z-index: var(--z-header);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7rem var(--page-padding-x) 3.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-premium);
  }

  .mobile-nav-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    max-width: 500px;
    width: 100%;
    margin: 0 auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    font-size: 2.25rem;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity var(--duration-slow) var(--ease-premium),
                transform var(--duration-slow) var(--ease-premium),
                color var(--duration-fast) var(--ease-premium);
    transition-delay: calc(var(--stagger-index) * 50ms + 80ms);
  }

  .mobile-nav-overlay.is-active .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav-link:hover {
    color: var(--text-primary);
  }

  .mobile-nav-link .link-number {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }

  .mobile-nav-footer {
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-contact-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .meta-label {
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  .meta-email {
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .mobile-actions {
      display: block;
    }
    .site-header {
      padding: 1.5rem var(--page-padding-x);
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-nav-overlay');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    const handleScroll = () => {
      if (window.scrollY > 40) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    const toggleMenu = () => {
      const isOpen = menuBtn?.classList.toggle('is-open');
      overlay?.classList.toggle('is-active');
      menuBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      overlay?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');

      if (isOpen) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    };

    menuBtn?.addEventListener('click', toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (menuBtn?.classList.contains('is-open')) {
          toggleMenu();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('astro:page-load', initHeader);
</script>
