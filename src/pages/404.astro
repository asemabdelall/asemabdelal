---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
---

<BaseLayout title="404 — Page Not Found" description="The requested page could not be found.">
  <section class="not-found-section">
    <div class="container">
      <div class="not-found-inner">
        <h1 class="error-code">404</h1>
        <p class="error-statement">The page you are looking for does not exist or has been moved.</p>
        <div class="error-actions">
          <ArrowLink href="/" text="Return to Home" variant="pill" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 80vh;
    min-height: 80dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 6rem;
  }

  .not-found-inner {
    padding: clamp(3rem, 6vw, 5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .error-code {
    font-size: clamp(5rem, 14vw, 8.5rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .error-statement {
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    max-width: 420px;
  }

  .error-actions {
    margin-top: 1rem;
  }
</style>
