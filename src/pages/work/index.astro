---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SelectedWork from '../../components/sections/SelectedWork.astro';
---

<BaseLayout 
  title="Selected Work — Asem Abdelal"
  description="Featured digital products, mobile applications, and custom business platforms designed and built by Asem Abdelal."
>
  <div class="work-page-header">
    <div class="container">
      <h1 class="page-title">Selected Work.</h1>
      <p class="page-desc">Explore recent digital products, mobile apps, and enterprise platforms built for growing businesses.</p>
    </div>
  </div>
  <SelectedWork />
</BaseLayout>

<style>
  .work-page-header {
    padding-top: 9rem;
    padding-bottom: 1.5rem;
  }

  .page-title {
    font-size: var(--text-title-1);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0.5rem 0 0.85rem;
  }

  .page-desc {
    font-size: var(--text-body-lg);
    color: var(--text-secondary);
    max-width: 600px;
  }
</style>
